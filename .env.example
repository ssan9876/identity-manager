# OWNER / MIGRATION connection. Owns the schema (every table, every
# sequence, the audit_log_append_only() trigger function) and is the only
# credential `pnpm --filter @idm/api db:migrate` ever connects with — never
# used by the running app or the sync worker. See RUNTIME_DATABASE_URL below
# and docs/superpowers/audit-integrity.md finding H1 / README.md's "Database
# roles" section for why the split exists.
DATABASE_URL=postgres://idm:idm_dev_password@localhost:5432/identity_manager
# RUNTIME connection. What the API process and the SyncWorker actually
# connect as: full SELECT/INSERT/UPDATE/DELETE on ordinary tables, but only
# SELECT/INSERT on audit_log — no UPDATE/DELETE/TRUNCATE, no ownership, no
# CREATE on the schema, so this role cannot ALTER/DROP/CREATE OR REPLACE any
# object, including the append-only trigger function itself.
# `db:migrate` (run as the OWNER above) provisions this exact role from this
# URL's own username/password — see apps/api/src/db/roles.ts. Required: the
# app fails to boot rather than falling back to DATABASE_URL if this is unset.
RUNTIME_DATABASE_URL=postgres://idm_app:idm_app_dev_password@localhost:5432/identity_manager
KEYCLOAK_ISSUER=http://localhost:8080/realms/identity-manager
KEYCLOAK_AUDIENCE=idm-api
KEYCLOAK_ADMIN_CLIENT_ID=idm-sync-service
KEYCLOAK_ADMIN_CLIENT_SECRET=idm_sync_dev_secret_change_me
PORT=3000
# Starts the outbox-draining SyncWorker alongside `start:dev`/production
# boot. Defaults to "true" when absent; set to "false" to run the app
# without it (e.g. a secondary instance behind a load balancer).
SYNC_WORKER_ENABLED=true
# Ceiling on physical Postgres connections the API's pool will ever open.
# Defaults to 10 (pg's own default) when absent.
DB_POOL_MAX=10
# Milestone 14, Task 9 (connector console) — a resolvable credential for the
# in-repo echo connector target, so the console's own dry-run/apply flow (and
# its Playwright E2E) has a real environment variable to name via
# connector_targets.config.credentialSecretName. Not read by anything unless
# a connector_targets row is configured to name it — see connectors/secrets.ts.
CONNECTOR_ECHO_CREDENTIAL=dev_echo_secret_change_me
