{
  "name": "@idm/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:dev": "node --watch --require @swc-node/register --env-file-if-exists=../../.env src/main.ts",
    "test": "vitest run",
    "smoke:dev": "tsx --env-file-if-exists=../../.env scripts/smoke-dev.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "reconcile": "tsx --env-file-if-exists=../../.env src/outbox/reconcile-cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "drizzle-orm": "^0.36.0",
    "jose": "^5.9.6",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.4",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.7.35",
    "@testcontainers/postgresql": "^10.13.2",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.28.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.3"
  }
}
